01,"indent":0,"parameters":["\\C[23](Stop it!)"]},{"code":231,"indent":0,"parameters":[2,"shin 2a1",1,0,400,328,75,75,255,0]},{"code":101,"indent":0,"parameters":["",0,2,2,"Own Shadow"]},{"code":401,"indent":0,"parameters":["“You’ll be cut loose like the dead weight that you are.”"]},{"code":235,"indent":0,"parameters":[2]},{"code":231,"indent":0,"parameters":[1,"shin 2b1",1,0,400,328,75,75,255,0]},{"code":101,"indent":0,"parameters":["",0,2,2,"Own Shadow"]},{"code":401,"indent":0,"parameters":["“Slaughtered like a lamb, your bones a mere ladder for the "]},{"code":401,"indent":0,"parameters":["strong to climb.”"]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,2,2,"Shin"]},{"code":401,"indent":0,"parameters":["\\C[23](...)"]},{"code":101,"indent":0,"parameters":["",0,2,2,"Shin"]},{"code":401,"indent":0,"parameters":["\\C[23](...)"]},{"code":231,"indent":0,"parameters":[2,"shin 2a1",1,0,400,328,75,75,255,0]},{"code":101,"indent":0,"parameters":["",0,2,2,"Own Shadow"]},{"code":401,"indent":0,"parameters":["“So, what’ll it be?”"]},{"code":235,"indent":0,"parameters":[2]},{"code":101,"indent":0,"parameters":["",0,2,2,"Shin"]},{"code":401,"indent":0,"parameters":["\\C[23](...What choice do I have, really?)"]},{"code":231,"indent":0,"parameters":[2,"shin 2a1",1,0,400,328,75,75,255,0]},{"code":101,"indent":0,"parameters":["",0,2,2,"Own Shadow"]},{"code":401,"indent":0,"parameters":["“Ahaha. Exactly.”"]},{"code":101,"indent":0,"parameters":["",0,2,2,"Own Shadow"]},{"code":401,"indent":0,"parameters":["“If you don’t wanna die... you change.”"]},{"code":235,"indent":0,"parameters":[2]},{"code":101,"indent":0,"parameters":["",0,2,2,"Shin"]},{"code":401,"indent":0,"parameters":["\\C[23](You say it as if it’s so easy...)"]},{"code":101,"indent":0,"parameters":["",0,2,2,"Shin"]},{"code":401,"indent":0,"parameters":["\\C[23](...but...)"]},{"code":101,"indent":0,"parameters":["",0,2,2,"Shin"]},{"code":401,"indent":0,"parameters":["\\C[23](...If having a chance at surviving...)"]},{"code":101,"indent":0,"parameters":["",0,2,2,"Shin"]},{"code":401,"indent":0,"parameters":["\\C[23](...means changing...)"]},{"code":101,"indent":0,"parameters":["",0,2,2,"Shin"]},{"code":401,"indent":0,"parameters":["\\C[23](...I have to try...!)"]},{"code":102,"indent":0,"parameters":[["Abandon Yourself"],-1,0,2,0]},{"code":402,"indent":0,"parameters":[0,"Abandon Yourself"]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[2,"shin 2a1",1,0,400,328,75,75,255,0]},{"code":101,"indent":0,"parameters":["",0,2,2,""]},{"code":401,"indent":0,"parameters":[""]},{"code":235,"indent":0,"parameters":[2]},{"code":222,"indent":0,"parameters":[]},{"code":223,"indent":0,"parameters":[[0,0,0,0],15,false]},{"code":284,"indent":0,"parameters":["small blackboard room 1",false,false,0,0]},{"code":101,"indent":0,"parameters":["",0,2,2,""]},{"code":401,"indent":0,"parameters":["\\C[24]My eyes wander to the papers left carelessly scattered"]},{"code":401,"indent":0,"parameters":["across the ground. I pick them up cautiously, as if they’re "]},{"code":401,"indent":0,"parameters":["about to bite"]},{"code":101,"indent":0,"parameters":["",0,2,2,""]},{"code":401,"indent":0,"parameters":["\\C[24]I stare, memorising the names of my potential allies, "]},{"code":401,"indent":0,"parameters":["friends...enemies? "]},{"code":101,"indent":0,"parameters":["",0,2,2,""]},{"code":401,"indent":0,"parameters":["\\C[24]My resolve strengthens."]},{"code":101,"indent":0,"parameters":["",0,2,2,"Shin"]},{"code":401,"indent":0,"parameters":["“I won’t allow these papers to mark my death.”"]},{"code":235,"indent":0,"parameters":[32]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":0,"y":0},
